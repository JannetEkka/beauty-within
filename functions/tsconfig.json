{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../src/server/**/*.ts", "../src/domain/**/*.ts", "../fixtures/**/*.ts"],
  "exclude": ["../src/**/*.test.ts"]
}
